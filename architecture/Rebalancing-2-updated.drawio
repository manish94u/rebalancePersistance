        <mxCell id="title" value="&lt;b&gt;Rebalancing II: Two-Dimensional Subscription Redistribution&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=28;fontColor=#17324D;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
