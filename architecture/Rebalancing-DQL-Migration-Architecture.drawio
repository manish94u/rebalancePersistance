        </mxCell>
        <mxCell id="subtitle" value="Architecture-centric view of probe establishment, telemetry, learned action selection, and fenced handoff. Durable subscription queues and their backlog remain stationary." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#475467;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
