        <!-- Protocol B: promote retained probe and migrate connection/subscriptions -->
        <mxCell id="path_b_frame" value="" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFBF2;strokeColor=#C58B27;strokeWidth=2;" vertex="1" parent="1">
