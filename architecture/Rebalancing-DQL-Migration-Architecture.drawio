        </mxCell>
        <mxCell id="path_a_header" value="&lt;b&gt;A&#160;&#160;DQL subscription rebalancing&lt;/b&gt;&lt;br&gt;a&lt;sup&gt;rebN&lt;/sup&gt; or a&lt;sup&gt;rebG&lt;/sup&gt;&lt;br&gt;&lt;font color=&quot;#667085&quot;&gt;existing sockets stay open; Q&lt;sub&gt;k*&lt;/sub&gt; stays stationary&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#155E75;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="55" y="718" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="&lt;b&gt;A1&#160;&#160;DQL chooses&lt;/b&gt;&lt;br&gt;a&lt;sup&gt;rebN&lt;/sup&gt; or a&lt;sup&gt;rebG&lt;/sup&gt; and k*" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#155E75;fillColor=#FFFFFF;strokeColor=#0E7490;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="390" y="730" width="220" height="60" as="geometry" /></mxCell>
        <mxCell id="a2" value="&lt;b&gt;A2&#160;&#160;PREPARE k*&lt;/b&gt;&lt;br&gt;shadow attach on c&lt;sub&gt;l&lt;/sub&gt;; delivery off" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#344054;fillColor=#FFFFFF;strokeColor=#98A2B3;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="650" y="730" width="220" height="60" as="geometry" /></mxCell>
        <mxCell id="a3" value="&lt;b&gt;A3&#160;&#160;Quiesce k*&lt;/b&gt;&lt;br&gt;ACK and cursor barrier on c&lt;sub&gt;h&lt;/sub&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#344054;fillColor=#FFFFFF;strokeColor=#98A2B3;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="910" y="730" width="220" height="60" as="geometry" /></mxCell>
        <mxCell id="a4" value="&lt;b&gt;A4&#160;&#160;Update association&lt;/b&gt;&lt;br&gt;lease owner/cursor moves to c&lt;sub&gt;l&lt;/sub&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#4A3D6B;fillColor=#F3EFFA;strokeColor=#7B61A8;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="1170" y="730" width="220" height="60" as="geometry" /></mxCell>
        <mxCell id="a5" value="&lt;b&gt;A5&#160;&#160;Activate on c&lt;sub&gt;l&lt;/sub&gt;&lt;/b&gt;&lt;br&gt;detach k* from c&lt;sub&gt;h&lt;/sub&gt;; both TCP sockets remain active" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#285E3B;fillColor=#EAF7EE;strokeColor=#2F855A;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="1430" y="730" width="390" height="60" as="geometry" /></mxCell>
        <mxCell id="a_edge1" edge="1" parent="1" source="a1" target="a2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#0E7490;strokeWidth=1.8;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a_edge2" edge="1" parent="1" source="a2" target="a3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#667085;strokeWidth=1.8;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a_edge3" edge="1" parent="1" source="a3" target="a4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7B61A8;strokeWidth=1.8;"><mxGeometry relative="1" as="geometry" /></mxCell>
