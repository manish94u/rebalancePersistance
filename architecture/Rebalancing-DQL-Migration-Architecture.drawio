        </mxCell>
        <mxCell id="path_b_header" value="&lt;b&gt;B&#160;&#160;Conditional probe promotion and subscription migration&lt;/b&gt;&lt;br&gt;a&lt;sup&gt;mig&lt;/sup&gt;&lt;br&gt;&lt;font color=&quot;#667085&quot;&gt;most probes remain telemetry-only; promotion occurs only after DQL selection and deterministic guards&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#7A4B00;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="55" y="865" width="305" height="95" as="geometry" />
        </mxCell>
        <mxCell id="b1" value="&lt;b&gt;B1&#160;&#160;Evaluate p&lt;/b&gt;&lt;br&gt;DQL scores a&lt;sup&gt;mig&lt;/sup&gt; for retained P&lt;sub&gt;p&lt;/sub&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontColor=#7A4B00;fillColor=#FFFFFF;strokeColor=#C58B27;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="390" y="870" width="160" height="75" as="geometry" /></mxCell>
        <mxCell id="b2" value="&lt;b&gt;B2&#160;&#160;Admissibility gate&lt;/b&gt;&lt;br&gt;a&lt;sup&gt;mig&lt;/sup&gt; selected and freshness, capacity, cooldown, hysteresis pass?" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=9;fontColor=#7A4B00;fillColor=#FFF5D6;strokeColor=#C58B27;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="570" y="870" width="160" height="75" as="geometry" /></mxCell>
        <mxCell id="b3" value="&lt;b&gt;B3&#160;&#160;PROMOTE same p&lt;/b&gt;&lt;br&gt;token + transferId + manifest + source epoch" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=9;fontColor=#7A4B00;fillColor=#FFF5D6;strokeColor=#C58B27;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="750" y="870" width="160" height="75" as="geometry" /></mxCell>
        <mxCell id="b4" value="&lt;b&gt;B4&#160;&#160;Shadow attach&lt;/b&gt;&lt;br&gt;target creates subscriptions; delivery OFF" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontColor=#344054;fillColor=#FFFFFF;strokeColor=#98A2B3;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="930" y="870" width="160" height="75" as="geometry" /></mxCell>
        <mxCell id="b5" value="&lt;b&gt;B5&#160;&#160;QUIESCE c&lt;sub&gt;h&lt;/sub&gt;&lt;/b&gt;&lt;br&gt;stop new delivery; resolve in-flight set" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontColor=#9B2C2C;fillColor=#FDECEC;strokeColor=#B84A4A;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="1110" y="870" width="160" height="75" as="geometry" /></mxCell>
        <mxCell id="b6" value="&lt;b&gt;B6&#160;&#160;ACK barrier&lt;/b&gt;&lt;br&gt;durable cursor r; ACK/NACK or requeue" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontColor=#344054;fillColor=#FFFFFF;strokeColor=#98A2B3;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="1290" y="870" width="160" height="75" as="geometry" /></mxCell>
        <mxCell id="b7" value="&lt;b&gt;B7&#160;&#160;Lease CAS&lt;/b&gt;&lt;br&gt;(P&lt;sub&gt;s&lt;/sub&gt;, e) &amp;rarr; (P&lt;sub&gt;p&lt;/sub&gt;, e+1)" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontColor=#4A3D6B;fillColor=#F3EFFA;strokeColor=#7B61A8;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="1470" y="870" width="160" height="75" as="geometry" /></mxCell>
        <mxCell id="b8" value="&lt;b&gt;B8&#160;&#160;ACTIVATE / READY&lt;/b&gt;&lt;br&gt;p becomes c&lt;sub&gt;t&lt;/sub&gt;; resume r+1; retire c&lt;sub&gt;h&lt;/sub&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=9;fontColor=#285E3B;fillColor=#EAF7EE;strokeColor=#2F855A;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="1650" y="870" width="160" height="75" as="geometry" /></mxCell>
