        <mxCell id="title" value="&lt;b&gt;DQL-Guided Persistent-Connection Rebalancing and Probe-Assisted Subscription Migration&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=27;fontColor=#17324D;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
