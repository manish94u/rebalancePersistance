        <mxCell id="b_edge2" value="yes" edge="1" parent="1" source="b2" target="b3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#C58B27;strokeWidth=1.8;fontFamily=Helvetica;fontSize=9;fontColor=#7A4B00;labelBackgroundColor=#FFFFFF;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b_edge3" edge="1" parent="1" source="b3" target="b4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#667085;strokeWidth=1.8;"><mxGeometry relative="1" as="geometry" /></mxCell>
