        <!-- Protocol A: bounded subscription reassociation across existing connections -->
        <mxCell id="path_a_frame" value="" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#F2FBFC;strokeColor=#0E7490;strokeWidth=2;" vertex="1" parent="1">
