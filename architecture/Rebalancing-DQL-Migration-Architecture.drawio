        <mxCell id="target_pod_text" value="&lt;b&gt;Existing lower-load subscriber Pod P&lt;sub&gt;l&lt;/sub&gt;&lt;/b&gt;&lt;br&gt;already connected through c&lt;sub&gt;l&lt;/sub&gt;; receives k* under action A&lt;br&gt;&lt;font color=&quot;#276749&quot;&gt;PREPARE + ACK/cursor barrier + reassociation; queue Q&lt;sub&gt;k*&lt;/sub&gt; stays in place&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#344054;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
